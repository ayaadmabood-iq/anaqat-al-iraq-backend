.pnpm-store/

# --- Build output ------------------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.turbo/
.parcel-cache/
*.tsbuildinfo

# --- Environment & secrets ---------------------------------------------------
.env
.env.*
\!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# --- Runtime / storage / uploads --------------------------------------------
uploads/
\!uploads/.gitkeep
storage/books/*
\!storage/books/.gitkeep
storage/generated/*
\!storage/generated/.gitkeep
storage/transfers/*
\!storage/transfers/.gitkeep
tmp/
temp/
pids/
*.pid
*.seed
*.pid.lock

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing / coverage ------------------------------------------------------
coverage/
*.lcov
.nyc_output/
.jest-cache/

# --- IDE / editor ------------------------------------------------------------
.vscode/
\!.vscode/settings.json.example
.idea/
.fleet/
.history/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# --- OS ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
