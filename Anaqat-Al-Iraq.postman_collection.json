{
  "info": {
    "name": "Anaqat Al-Iraq API",
    "description": "API collection for testing Anaqat Al-Iraq backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "storeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 — Get Store ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/stores",
          "host": ["{{baseUrl}}"],
          "path": ["stores"]
        },
        "description": "Get all stores to find the demo store ID. Run this FIRST, then copy the store id to the collection variable 'storeId'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (Array.isArray(jsonData) && jsonData.length > 0) {",
              "    pm.collectionVariables.set('storeId', jsonData[0].id);",
              "    console.log('storeId set to: ' + jsonData[0].id);",
              "}",
              "pm.test('Stores returned', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "1 — Login (owner)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"owner\",\n  \"password\": \"demo123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login?storeId={{storeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"],
          "query": [
            {
              "key": "storeId",
              "value": "{{storeId}}"
            }
          ]
        },
        "description": "Login as owner. The access_token is automatically saved to collection variables."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.access_token) {",
              "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
              "    console.log('Token saved!');",
              "}",
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.expect(jsonData.user.role).to.eql('OWNER');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2 — Get Inventory Items",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inventory/items",
          "host": ["{{baseUrl}}"],
          "path": ["inventory", "items"]
        },
        "description": "Get all inventory items for the logged-in user's store."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Items returned', function () {",
              "    pm.response.to.have.status(200);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    console.log('Items count: ' + jsonData.length);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3 — Sales Report Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sales/report/summary",
          "host": ["{{baseUrl}}"],
          "path": ["sales", "report", "summary"]
        },
        "description": "Get sales summary report. Requires OWNER or MANAGER role."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Report returned', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
