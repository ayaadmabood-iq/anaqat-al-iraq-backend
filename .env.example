# ============================================================================
# Anaqat Al-Iraq — backend environment
# Copy to .env and fill in. Keys marked "REQUIRED in production" are enforced
# at boot by src/config/validation.schema.ts; the process will not start if
# they are missing or take insecure defaults.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development                 # one of: development | test | production
PORT=3000

# --- Security / CORS --------------------------------------------------------
# REQUIRED in production. Must NOT be '*' when NODE_ENV=production.
# Accepts a comma-separated list of allowed origins.
#   prod  : CORS_ORIGIN=https://app.example.com,https://admin.example.com
#   dev   : * (default)
CORS_ORIGIN=*

# REQUIRED in production. Used to build public URLs for uploaded images.
# e.g. https://api.example.com  (no trailing slash)
APP_BASE_URL=

# Max request body size for JSON / urlencoded. Used by express.json/urlencoded.
BODY_LIMIT=1mb

# --- Rate limiting ----------------------------------------------------------
# Global throttle applied by ThrottlerGuard. /healthz is exempt.
THROTTLE_TTL=60                      # window in seconds
THROTTLE_LIMIT=120                   # max requests per window per IP

# --- Database (Postgres) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# REQUIRED in production. Must NOT be 'postgres' when NODE_ENV=production.
DB_PASSWORD=postgres
DB_DATABASE=anaqat_iraq

# Dev/test auto-sync schema via TypeORM. Production forces migrations.
# Set to 'false' in dev if you want to use migrations locally too.
# DB_SYNCHRONIZE=true

# Postgres TLS (recommended for managed DBs).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# --- JWT --------------------------------------------------------------------
# REQUIRED always. Min 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-min-16-characters
JWT_EXPIRATION=24h

# --- Optional features ------------------------------------------------------
GOOGLE_VISION_API_KEY=

# Upload directory (relative paths are resolved against cwd).
UPLOAD_DIR=uploads
